{
	"name": "@savvy-web/silk-release-action",
	"version": "5.11.0",
	"private": true,
	"description": "Automated release management GitHub Action with changesets, multi-registry publishing, and GitHub releases.",
	"homepage": "https://github.com/savvy-web/silk-release-action#readme",
	"bugs": {
		"url": "https://github.com/savvy-web/silk-release-action/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/silk-release-action.git"
	},
	"license": "MIT",
	"author": "Savvy Web Systems <spencer@savvyweb.systems> (https://savvyweb.systems)",
	"type": "module",
	"scripts": {
		"build": "turbo run build:prod --log-order=grouped",
		"build:prod": "effected action build",
		"check:collection": "node scripts/check-test-collection.mjs",
		"ci:build": "CI=\"true\" turbo run build:prod --log-order=grouped --output-logs=full",
		"ci:test": "node scripts/check-test-collection.mjs && effected schema check lib/scripts/schemastore.config.ts && CI=\"true\" vitest run --coverage",
		"ci:version": "savvy changeset version && biome format --write .",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 '**/*.{md,mdx}' --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2  --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"schema:build": "effected schema build lib/scripts/schemastore.config.ts",
		"schema:check": "effected schema check lib/scripts/schemastore.config.ts",
		"test": "vitest run --pass-with-no-tests",
		"test:coverage": "vitest run --coverage --pass-with-no-tests",
		"test:watch": "vitest --watch --pass-with-no-tests",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effected/changesets": "catalog:effected",
		"@effected/commands": "catalog:effected",
		"@effected/git": "catalog:effected",
		"@effected/github": "catalog:effected",
		"@effected/github-actions": "catalog:effected",
		"@effected/github-references": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/markdown": "catalog:effected",
		"@effected/npm": "catalog:effected",
		"@effected/package-json": "catalog:effected",
		"@effected/sbom": "catalog:effected",
		"@effected/schemastore": "catalog:effected",
		"@effected/semver": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@savvy-web/silk-effects": "^12.0.0",
		"effect": "catalog:effected"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effected",
		"@effected/memfs": "catalog:effected",
		"@effected/plugin": "catalog:effected",
		"@okfit/plugin": "^0.5.29",
		"@savvy-web/silk": "^5.0.0",
		"@vitest-agent/plugin": "^6.0.5",
		"tsx": "catalog:effected:build"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.17.0",
			"onFail": "download"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.13.0",
				"onFail": "ignore"
			}
		]
	}
}
